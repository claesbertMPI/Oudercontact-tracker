generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Student {
  id             Int    @id @default(autoincrement())
  leerlingnummer String @unique
  firstName      String
  lastName       String

  classId Int?
  class   Class? @relation(fields: [classId], references: [id], onUpdate: Cascade, onDelete: SetNull)

  attendances Attendance[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([lastName, firstName])
  @@index([classId])
}

model Class {
  id       Int       @id @default(autoincrement())
  code     String    @unique
  naam     String?
  students Student[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Oudercontact {
  id          Int          @id @default(autoincrement())
  title       String
  date        DateTime
  schoolYear  String
  period      String
  attendances Attendance[]
}

model Attendance {
  id             Int @id @default(autoincrement())
  studentId      Int
  oudercontactId Int

  student      Student      @relation(fields: [studentId], references: [id])
  oudercontact Oudercontact @relation(fields: [oudercontactId], references: [id])

  present   Boolean
  comment   String?
  createdAt DateTime @default(now())

  @@unique([studentId, oudercontactId])
  @@index([studentId])
  @@index([oudercontactId])
}
