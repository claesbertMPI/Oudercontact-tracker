generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/* ----------------------------- AUTH / ROLES ----------------------------- */

enum Role {
  ADMIN
  USER
}

model User {
  id            String   @id @default(cuid())
  name          String?
  email         String?  @unique
  emailVerified DateTime?
  image         String?
  role          Role     @default(USER)

  accounts      Account[]
  sessions      Session[]
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String

  refresh_token      String? @db.Text
  access_token       String? @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String? @db.Text
  session_state      String?
  oauth_token_secret String? @db.Text
  oauth_token        String? @db.Text

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

/* ----------------------------- APP MODELS ------------------------------- */

model Student {
  id             Int          @id @default(autoincrement())
  leerlingnummer String       @unique
  firstName      String
  lastName       String
  classId        Int?
  class          Class?       @relation(fields: [classId], references: [id], onUpdate: Cascade, onDelete: SetNull)
  attendances    Attendance[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([lastName, firstName])
  @@index([classId])
}

model Class {
  id        Int       @id @default(autoincrement())
  code      String    @unique
  naam      String?
  students  Student[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Oudercontact {
  id          Int          @id @default(autoincrement())
  title       String
  date        DateTime
  schoolYear  String
  period      String
  attendances Attendance[]
}

model Attendance {
  id             Int          @id @default(autoincrement())
  studentId      Int
  oudercontactId Int

  // Cascade zodat gekoppelde aanwezigheden automatisch verdwijnen
  student        Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  oudercontact   Oudercontact @relation(fields: [oudercontactId], references: [id], onDelete: Cascade)

  // Oud veld (optioneel gebruiken): present
  present             Boolean
  comment             String?

  // Nieuwe 4 vinkjes
  fysiekAanwezig     Boolean   @default(false)
  telefonischOnline  Boolean   @default(false)
  afwezig            Boolean   @default(false)
  opvangGebruikt     Boolean   @default(false)

  createdAt DateTime @default(now())

  @@unique([studentId, oudercontactId])
  @@index([studentId])
  @@index([oudercontactId])
}
